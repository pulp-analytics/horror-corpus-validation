# Copy to .env and fill in. Never commit the real .env file.
# Loaded automatically (scripts/utils/aws_config.py) -- no need to `export`
# these into your shell yourself; just having .env in the repo root is enough.

# https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_v3_api_key_here

# AWS credentials for Comprehend / Translate / Bedrock (Nova Pro).
# Prefer a named profile (`aws configure --profile horror-validation`) and
# set AWS_PROFILE instead of putting keys here. See docs/AWS_SETUP.md.
AWS_PROFILE=your-aws-profile
# Actually read by utils/aws_config.get_client() -- change this if your
# Bedrock/Comprehend/Translate access is set up in a different region.
# Defaults to us-east-1 if unset.
AWS_DEFAULT_REGION=us-east-1
