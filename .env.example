# Copy to .env and fill in. Never commit the real .env file.

# https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_v3_api_key_here

# AWS credentials for Comprehend / Translate / Bedrock (Nova Pro).
# Prefer a named profile (`aws configure --profile horror-validation`) and
# set AWS_PROFILE instead of putting keys here. See docs/AWS_SETUP.md.
AWS_PROFILE=your-aws-profile
AWS_DEFAULT_REGION=us-east-1
